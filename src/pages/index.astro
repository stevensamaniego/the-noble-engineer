---
import Layout from '../layouts/Layout.astro'
---

<Layout>
  <!-- Fixed full-viewport backdrop — the Three.js Orion constellation scene
       with the 3D logo emblem (see hero.ts). It stays pinned while the page
       scrolls over it; sections below use semi-transparent backgrounds so the
       starfield stays alive behind all content. -->
  <canvas id="hero-canvas" class="fixed top-0 left-0 w-screen h-screen z-0" role="img" aria-label="The Noble Engineer — tree emblem floating before the Orion constellation"></canvas>

  <!-- Hero — transparent, the constellation shows through fully -->
  <section id="hero" class="relative h-screen flex items-center justify-center overflow-hidden">
    <h1 class="sr-only">The Noble Engineer</h1>
    <div class="relative z-10 flex flex-col items-center text-center px-6">
      <p class="text-accent font-mono text-sm tracking-[0.3em] uppercase opacity-0" data-hero-reveal="eyebrow">Engineering the Future</p>
      <!-- Logo slot — empty space the 3D emblem occupies on the canvas behind -->
      <div class="h-[30vh] min-h-[220px] md:h-[38vh] md:min-h-[320px]" aria-hidden="true"></div>
      <p class="text-text-muted text-lg md:text-xl max-w-xl mx-auto opacity-0" data-hero-reveal="subtitle">
        Technology consulting, custom software, and infrastructure — built to last.
      </p>
    </div>
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 opacity-0" data-hero-reveal="scroll-hint">
      <div class="w-5 h-8 border-2 border-accent/40 rounded-full flex justify-center pt-1">
        <div class="w-1 h-2 bg-accent rounded-full animate-bounce"></div>
      </div>
    </div>
  </section>

  <!-- Curiosity gap — hidden at load; the opening line fades up as the user
       begins to scroll, the resolution reveals a beat later. Zeigarnik Effect:
       open loop → must scroll. -->
  <section class="relative z-10 -mt-6 px-6 pb-32 md:pb-44 bg-void/85" aria-label="Why engineering matters">
    <div class="max-w-6xl mx-auto">
      <p class="text-[clamp(2rem,5vw,4rem)] font-extrabold tracking-tight leading-[1.12] text-text opacity-0" data-animate="fade-up">
        Most companies don't have a technology problem—
      </p>
      <p class="text-[clamp(2rem,5vw,4rem)] font-extrabold tracking-tight leading-[1.12] text-accent mt-8 md:mt-12" data-animate="fade-up">
        —they have an engineering problem.
      </p>
    </div>
  </section>

  <!-- Problem space — the pain before the cure. Loss aversion + pattern
       recognition: the visitor sees their own history reflected back. -->
  <section id="problem" class="relative px-6 py-28 md:py-40 overflow-hidden bg-void/90">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-4xl md:text-6xl font-bold tracking-tight leading-[1.05] mb-14 md:mb-20 opacity-0" data-split>
        You've been here before.
      </h2>
      <div class="max-w-3xl space-y-8 md:space-y-10" data-animate-group data-stagger="0.15">
        <p class="text-xl md:text-2xl text-text-muted leading-relaxed">The consultant who billed six figures and left you with a slide deck.</p>
        <p class="text-xl md:text-2xl text-text-muted leading-relaxed">The vendor who promised seamless integration and delivered a mess.</p>
        <p class="text-xl md:text-2xl text-text-muted leading-relaxed">The dev shop that built it fast, disappeared faster, and left no one who could maintain it.</p>
      </div>
      <p class="serif-voice text-2xl md:text-[2rem] text-text mt-24 md:mt-36" data-animate="fade-up">
        There's a better way to build.
      </p>
    </div>
  </section>

  <!-- Services — editorial intro -->
  <section id="services" class="relative pt-36 md:pt-48 pb-20 px-6 overflow-hidden bg-void/90">
    <div class="pointer-events-none absolute -right-40 top-24 w-[500px] h-[500px] rounded-full bg-accent/[0.03] blur-3xl" data-parallax="0.25"></div>
    <div class="max-w-7xl mx-auto">
      <p class="font-mono text-xs tracking-[0.3em] uppercase text-text-muted mb-6" data-animate="fade-up">01 — 04 &nbsp;/&nbsp; Services</p>
      <h2 class="text-[clamp(2.6rem,7vw,6rem)] font-extrabold tracking-tight leading-[1.03] max-w-5xl opacity-0" data-split>
        The systems your business runs on, built by someone who has run them.
      </h2>
      <div class="flex justify-end mt-12 md:mt-16">
        <p class="text-text-muted text-lg max-w-md md:text-right" data-animate="fade-up">
          Four disciplines, one engineer-led practice. No hand-offs, no account managers — the person you talk to is the person who builds it.
        </p>
      </div>
    </div>
  </section>

  <!-- 01 — Custom Software -->
  <section class="relative px-6 py-28 md:py-40 overflow-hidden bg-void/90">
    <span class="service-index left-2 md:left-6" data-parallax="0.12" aria-hidden="true">01</span>
    <svg class="service-accent hidden md:block right-[8%] top-[14%] w-56" viewBox="0 0 200 160" fill="none" stroke-width="1" data-draw aria-hidden="true">
      <polyline points="14,128 58,74 104,96 152,30 186,52" />
      <line x1="104" y1="96" x2="128" y2="140" />
      <circle cx="14" cy="128" r="3" /><circle cx="58" cy="74" r="4" /><circle cx="104" cy="96" r="3" />
      <circle cx="152" cy="30" r="4.5" /><circle cx="186" cy="52" r="3" /><circle cx="128" cy="140" r="3" />
    </svg>
    <div class="max-w-7xl mx-auto grid grid-cols-12 gap-x-8 gap-y-12 items-start relative pt-16 md:pt-24">
      <div class="col-span-12 md:col-span-7">
        <p class="font-mono text-xs tracking-[0.3em] uppercase text-text-muted mb-5" data-animate="fade-up">Custom Software</p>
        <h3 class="text-[clamp(2.5rem,6.5vw,7rem)] font-extrabold tracking-tight leading-[1.02] mb-8 opacity-0" data-split>
          Software that ships — and stays shipped.
        </h3>
        <p class="text-text-muted text-lg leading-relaxed max-w-xl" data-animate="fade-up">
          Full-stack web platforms, native mobile apps, and the APIs behind them — built for real users on real deadlines. Production software that works the day it deploys and keeps working after everyone stops watching it.
        </p>
      </div>
      <div class="col-span-12 md:col-span-4 md:col-start-9 md:pt-10">
        <ul class="ledger" data-animate-group>
          <li class="ledger-item"><span class="ledger-num">/01</span><span class="ledger-label">Web platforms</span></li>
          <li class="ledger-item"><span class="ledger-num">/02</span><span class="ledger-label">Native mobile apps</span></li>
          <li class="ledger-item"><span class="ledger-num">/03</span><span class="ledger-label">APIs &amp; backends</span></li>
          <li class="ledger-item"><span class="ledger-num">/04</span><span class="ledger-label">Legacy modernization</span></li>
        </ul>
      </div>
    </div>
    <hr class="section-rule max-w-7xl mx-auto mt-24 md:mt-32" data-rule />
  </section>

  <!-- 02 — Infrastructure (pattern interrupt: centered, single column, air) -->
  <section class="relative px-6 py-32 md:py-48 overflow-hidden bg-void/90">
    <span class="service-index right-2 md:right-6" data-parallax="0.12" aria-hidden="true">02</span>
    <div class="max-w-3xl mx-auto text-center relative pt-16 md:pt-24">
      <p class="font-mono text-xs tracking-[0.3em] uppercase text-text-muted mb-5" data-animate="fade-up">Infrastructure</p>
      <h3 class="text-4xl md:text-6xl font-bold tracking-tight leading-[1.05] mb-10 opacity-0" data-split>
        Infrastructure without drama.
      </h3>
      <p class="text-text-muted text-lg md:text-xl leading-relaxed" data-animate="fade-up">
        Data centers. Cloud migrations. Network architecture. Designed to scale, built to be maintained, still running long after the launch.
      </p>
    </div>
    <hr class="section-rule max-w-7xl mx-auto mt-24 md:mt-32" data-rule />
  </section>

  <!-- 03 — System Integration -->
  <section class="relative px-6 py-28 md:py-40 overflow-hidden bg-void/90">
    <span class="service-index left-2 md:left-6" data-parallax="0.12" aria-hidden="true">03</span>
    <!-- Two systems, one animated bridge — CSS only -->
    <div class="service-bridge hidden md:flex right-[6%] top-[22%] w-72" data-animate="fade-up" aria-hidden="true">
      <span class="bridge-node"></span>
      <span class="bridge-track"><span class="bridge-pulse"></span></span>
      <span class="bridge-node"></span>
    </div>
    <div class="max-w-7xl mx-auto grid grid-cols-12 gap-x-8 gap-y-12 items-start relative pt-16 md:pt-24">
      <div class="col-span-12 md:col-span-7">
        <p class="font-mono text-xs tracking-[0.3em] uppercase text-text-muted mb-5" data-animate="fade-up">System Integration</p>
        <h3 class="text-4xl md:text-6xl font-bold tracking-tight leading-[1.05] mb-8 opacity-0" data-split>
          Make the systems you already own talk to each other.
        </h3>
        <p class="text-text-muted text-lg leading-relaxed max-w-xl" data-animate="fade-up">
          HR platforms, ERP databases, payroll tools, third-party APIs — bridged so data flows automatically instead of living in spreadsheets and inboxes. Integration work that turns a pile of vendors into one coherent system.
        </p>
      </div>
      <div class="col-span-12 md:col-span-4 md:col-start-9 md:pt-10">
        <ul class="ledger" data-animate-group>
          <li class="ledger-item"><span class="ledger-num">/01</span><span class="ledger-label">ERP &amp; HR platforms</span></li>
          <li class="ledger-item"><span class="ledger-num">/02</span><span class="ledger-label">Payroll &amp; finance systems</span></li>
          <li class="ledger-item"><span class="ledger-num">/03</span><span class="ledger-label">Third-party APIs</span></li>
          <li class="ledger-item"><span class="ledger-num">/04</span><span class="ledger-label">Workflow automation</span></li>
        </ul>
      </div>
    </div>
    <hr class="section-rule max-w-7xl mx-auto mt-24 md:mt-32" data-rule />
  </section>

  <!-- 04 — IT Strategy (mirrored) -->
  <section class="relative px-6 py-28 md:py-40 overflow-hidden bg-void/90">
    <span class="service-index right-2 md:right-6" data-parallax="0.12" aria-hidden="true">04</span>
    <svg class="service-accent hidden md:block left-[8%] top-[16%] w-56" viewBox="0 0 200 160" fill="none" stroke-width="1" data-draw aria-hidden="true">
      <polyline points="16,140 60,100 90,116 130,58 168,74 184,24" />
      <circle cx="16" cy="140" r="3" /><circle cx="60" cy="100" r="3.5" /><circle cx="90" cy="116" r="3" />
      <circle cx="130" cy="58" r="4" /><circle cx="168" cy="74" r="3" /><circle cx="184" cy="24" r="4.5" />
    </svg>
    <div class="max-w-7xl mx-auto grid grid-cols-12 gap-x-8 gap-y-12 items-start relative pt-16 md:pt-24">
      <div class="col-span-12 md:col-span-7 md:col-start-6 md:order-2">
        <p class="font-mono text-xs tracking-[0.3em] uppercase text-text-muted mb-5" data-animate="fade-up">IT Strategy</p>
        <h3 class="text-3xl md:text-[2.75rem] font-light tracking-tight leading-[1.15] mb-8 opacity-0" data-split>
          Strategy from the server room, not the slide deck.
        </h3>
        <p class="text-text-muted text-lg leading-relaxed max-w-xl" data-animate="fade-up">
          Vendor evaluation, security audits, system migrations, and operational overhauls — from someone who has run technology at scale. We assess what you have, plan what you need, and execute the transition, not just hand you a report.
        </p>
      </div>
      <div class="col-span-12 md:col-span-4 md:order-1 md:pt-10">
        <ul class="ledger" data-animate-group>
          <li class="ledger-item"><span class="ledger-num">/01</span><span class="ledger-label">Technology roadmaps</span></li>
          <li class="ledger-item"><span class="ledger-num">/02</span><span class="ledger-label">Vendor evaluation</span></li>
          <li class="ledger-item"><span class="ledger-num">/03</span><span class="ledger-label">Security audits</span></li>
          <li class="ledger-item"><span class="ledger-num">/04</span><span class="ledger-label">Migrations &amp; overhauls</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Social proof — evidence, not claims. Serif italic voice, thin accent
       borders (one of the few sanctioned cyan moments on the page). -->
  <section id="proof" class="relative py-32 md:py-44 px-6 overflow-hidden bg-surface/90">
    <div class="max-w-7xl mx-auto">
      <p class="font-mono text-xs tracking-[0.3em] uppercase text-text-muted mb-16 md:mb-20" data-animate="fade-up">From the field</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-14 md:gap-10" data-animate-group data-stagger="0.15">
        <blockquote class="quote">
          <p class="serif-voice text-xl md:text-[1.35rem] leading-relaxed text-text">&ldquo;We went from paper timesheets to a production platform in three weeks. Still running, zero downtime.&rdquo;</p>
          <footer class="quote-attr">IT Director, Construction</footer>
        </blockquote>
        <blockquote class="quote">
          <p class="serif-voice text-xl md:text-[1.35rem] leading-relaxed text-text">&ldquo;Finally, someone who speaks infrastructure AND code. We stopped needing two vendors.&rdquo;</p>
          <footer class="quote-attr">VP Operations, Manufacturing</footer>
        </blockquote>
        <blockquote class="quote">
          <p class="serif-voice text-xl md:text-[1.35rem] leading-relaxed text-text">&ldquo;The first consultant who built what they promised, documented it, and actually stuck around.&rdquo;</p>
          <footer class="quote-attr">COO, Professional Services</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- About — full-width centered narrative -->
  <section id="about" class="relative py-32 md:py-44 px-6 overflow-hidden bg-void/90">
    <div class="pointer-events-none absolute -left-40 top-20 w-[450px] h-[450px] rounded-full bg-accent-secondary/[0.04] blur-3xl" data-parallax="0.15"></div>
    <div class="max-w-3xl mx-auto text-center">
      <p class="font-mono text-xs tracking-[0.3em] uppercase text-text-muted mb-5" data-animate="fade-up">About</p>
      <h2 class="text-4xl md:text-6xl font-bold tracking-tight leading-[1.05] mb-8 opacity-0" data-split>
        Twenty years of building.
      </h2>
      <p class="serif-voice text-lg md:text-xl leading-relaxed text-text/85 mb-6" data-animate="fade-up">
        The first server rack I ever built was in a closet with no AC. Fifteen years later, I was designing data centers for a global brand — redundant power, redundant cooling, redundant everything. The closet taught me more.
      </p>
      <p class="serif-voice text-lg md:text-xl leading-relaxed text-text/85 mb-14" data-animate="fade-up" data-delay="0.1">
        That's the through-line: build real things, learn what breaks, carry those lessons forward. Every platform I ship, every network I design, every system I integrate — it's twenty years of knowing what actually goes wrong when you cut corners.
      </p>
      <div class="grid grid-cols-3 gap-6 max-w-2xl mx-auto" data-animate-group>
        <div>
          <p class="stat-num"><span data-count="20">0</span>+</p>
          <p class="stat-label mt-2">Years engineering</p>
        </div>
        <div>
          <p class="font-mono text-text text-lg md:text-xl mt-3 md:mt-5">DC&nbsp;→&nbsp;SaaS</p>
          <p class="stat-label mt-2">Data center to cloud</p>
        </div>
        <div>
          <p class="font-mono text-text text-lg md:text-xl mt-3 md:mt-5">Lead&nbsp;Eng</p>
          <p class="stat-label mt-2">Background</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="relative py-40 md:py-56 px-6 overflow-hidden bg-void/85">
    <div class="pointer-events-none absolute inset-0 flex items-center justify-center" aria-hidden="true">
      <div class="contact-ring w-80 h-80"></div>
      <div class="contact-ring w-80 h-80" style="animation-delay: 2s"></div>
    </div>
    <div class="max-w-6xl mx-auto relative">
      <p class="font-mono text-xs tracking-[0.3em] uppercase text-text-muted mb-6" data-animate="fade-up">Contact</p>
      <p class="font-mono text-sm tracking-[0.12em] text-accent mb-8" data-animate="fade-up" data-delay="0.05">
        Currently taking on two new engagements.
      </p>
      <h2 class="text-[clamp(2.6rem,7vw,5.5rem)] font-extrabold tracking-tight leading-[1.03] max-w-4xl mb-14 opacity-0" data-split>
        Let's build something that lasts.
      </h2>
      <a href="mailto:steven@thenobleengineer.com" class="email-link" data-magnetic data-animate="fade-up">
        steven@thenobleengineer.com
      </a>
      <p class="text-text-muted text-base md:text-lg mt-10" data-animate="fade-up" data-delay="0.15">
        Or just ask a question — no pitch, no follow-up sequence.
      </p>
    </div>
  </section>
</Layout>

<script>
  import { initHero } from '../scripts/hero'
  import { initAnimations } from '../scripts/animations'
  import { initInteractions } from '../scripts/interactions'

  initHero()
  initAnimations()
  initInteractions()
</script>
