---
import Layout from '../layouts/Layout.astro'
---

<Layout>
  <!-- Hero — Three.js Orion constellation scene -->
  <section id="hero" class="relative h-screen flex items-center justify-center overflow-hidden">
    <canvas id="hero-canvas" class="absolute inset-0 w-full h-full"></canvas>
    <div class="relative z-10 text-center px-6">
      <p class="text-accent font-mono text-sm tracking-[0.3em] uppercase mb-4 opacity-0" data-hero-reveal="eyebrow">Engineering the Future</p>
      <h1 class="text-6xl md:text-8xl font-extrabold tracking-tight leading-none mb-6 opacity-0 [perspective:800px]" data-hero-title>
        The Noble<br />
        <span class="text-accent glow-text" data-glitch data-text="Engineer">Engineer</span>
      </h1>
      <p class="text-text-muted text-lg md:text-xl max-w-xl mx-auto opacity-0" data-hero-reveal="subtitle">
        Technology consulting, custom software, and infrastructure — built to last.
      </p>
    </div>
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 opacity-0" data-hero-reveal="scroll-hint">
      <div class="w-5 h-8 border-2 border-accent/40 rounded-full flex justify-center pt-1">
        <div class="w-1 h-2 bg-accent rounded-full animate-bounce"></div>
      </div>
    </div>
  </section>

  <!-- Work / Projects -->
  <section id="work" class="relative py-32 px-6 overflow-hidden">
    <div class="pointer-events-none absolute -right-40 top-20 w-[500px] h-[500px] rounded-full bg-accent/[0.03] blur-3xl" data-parallax="0.25"></div>
    <div class="max-w-6xl mx-auto">
      <p class="text-accent font-mono text-sm tracking-[0.3em] uppercase mb-2" data-animate="fade-up">Selected Work</p>
      <h2 class="text-4xl md:text-5xl font-bold mb-16 opacity-0" data-split>Built to Perform</h2>
      <div class="grid md:grid-cols-2 gap-8" data-animate-group>
        <article class="tilt-card group relative bg-surface rounded-2xl border border-white/5 overflow-hidden" data-tilt>
          <div class="tilt-inner">
            <div class="aspect-video relative overflow-hidden">
              <div class="absolute inset-0 preview-gradient preview-gradient-a"></div>
              <div class="absolute inset-0 preview-grid"></div>
              <span class="absolute inset-0 flex items-center justify-center text-text-muted font-mono text-sm">[Project Preview]</span>
            </div>
            <div class="p-6 relative">
              <h3 class="text-xl font-semibold mb-2 group-hover:text-accent transition-colors duration-300">Project Title</h3>
              <p class="text-text-muted text-sm">Full-stack application with real-time data sync and enterprise integrations.</p>
              <div class="flex gap-2 mt-4">
                <span class="text-xs font-mono px-2 py-1 bg-accent/10 text-accent rounded">Next.js</span>
                <span class="text-xs font-mono px-2 py-1 bg-accent/10 text-accent rounded">Prisma</span>
                <span class="text-xs font-mono px-2 py-1 bg-accent/10 text-accent rounded">Vercel</span>
              </div>
            </div>
          </div>
          <div class="tilt-glare" aria-hidden="true"></div>
        </article>
        <article class="tilt-card group relative bg-surface rounded-2xl border border-white/5 overflow-hidden" data-tilt>
          <div class="tilt-inner">
            <div class="aspect-video relative overflow-hidden">
              <div class="absolute inset-0 preview-gradient preview-gradient-b"></div>
              <div class="absolute inset-0 preview-grid"></div>
              <span class="absolute inset-0 flex items-center justify-center text-text-muted font-mono text-sm">[Project Preview]</span>
            </div>
            <div class="p-6 relative">
              <h3 class="text-xl font-semibold mb-2 group-hover:text-accent transition-colors duration-300">Project Title</h3>
              <p class="text-text-muted text-sm">iOS and web platform with shared infrastructure and real-time monitoring.</p>
              <div class="flex gap-2 mt-4">
                <span class="text-xs font-mono px-2 py-1 bg-accent/10 text-accent rounded">Swift</span>
                <span class="text-xs font-mono px-2 py-1 bg-accent/10 text-accent rounded">PostgreSQL</span>
                <span class="text-xs font-mono px-2 py-1 bg-accent/10 text-accent rounded">REST API</span>
              </div>
            </div>
          </div>
          <div class="tilt-glare" aria-hidden="true"></div>
        </article>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section id="capabilities" class="relative py-32 px-6 bg-surface overflow-hidden">
    <div class="pointer-events-none absolute -left-40 bottom-0 w-[400px] h-[400px] rounded-full bg-accent-secondary/[0.04] blur-3xl" data-parallax="0.15"></div>
    <div class="max-w-6xl mx-auto">
      <p class="text-accent font-mono text-sm tracking-[0.3em] uppercase mb-2" data-animate="fade-up">Capabilities</p>
      <h2 class="text-4xl md:text-5xl font-bold mb-16 opacity-0" data-split>End-to-End Engineering</h2>
      <div class="grid md:grid-cols-3 gap-8" data-animate-group>
        <div class="cap-card p-8 rounded-2xl border border-white/5 bg-void/40">
          <div class="w-14 h-14 rounded-lg bg-accent/10 flex items-center justify-center mb-6">
            <!-- Infrastructure: network nodes with pulsing links -->
            <svg viewBox="0 0 48 48" class="w-8 h-8 icon-infra" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round">
              <path class="icon-draw" d="M24 14 L10 34 M24 14 L38 34 M10 34 L38 34" />
              <circle class="icon-node" cx="24" cy="14" r="3.5" fill="var(--color-accent)" stroke="none" />
              <circle class="icon-node" style="animation-delay: 0.4s" cx="10" cy="34" r="3.5" fill="var(--color-accent)" stroke="none" />
              <circle class="icon-node" style="animation-delay: 0.8s" cx="38" cy="34" r="3.5" fill="var(--color-accent)" stroke="none" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-3">Infrastructure</h3>
          <p class="text-text-muted text-sm leading-relaxed">Data center architecture, networking, cloud infrastructure, and hybrid deployments built for scale.</p>
        </div>
        <div class="cap-card p-8 rounded-2xl border border-white/5 bg-void/40">
          <div class="w-14 h-14 rounded-lg bg-accent/10 flex items-center justify-center mb-6">
            <!-- Software: code brackets with blinking cursor -->
            <svg viewBox="0 0 48 48" class="w-8 h-8" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path class="icon-draw" d="M16 14 L6 24 L16 34" />
              <path class="icon-draw" style="animation-delay: 0.3s" d="M32 14 L42 24 L32 34" />
              <line class="icon-cursor" x1="24" y1="15" x2="24" y2="33" stroke-width="2" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-3">Software Development</h3>
          <p class="text-text-muted text-sm leading-relaxed">Full-stack applications, APIs, mobile apps, and integrations — production-grade from day one.</p>
        </div>
        <div class="cap-card p-8 rounded-2xl border border-white/5 bg-void/40">
          <div class="w-14 h-14 rounded-lg bg-accent/10 flex items-center justify-center mb-6">
            <!-- Consulting: radar sweep -->
            <svg viewBox="0 0 48 48" class="w-8 h-8" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round">
              <circle cx="24" cy="24" r="18" opacity="0.35" />
              <circle cx="24" cy="24" r="10" opacity="0.5" />
              <g class="icon-radar" style="transform-origin: 24px 24px">
                <line x1="24" y1="24" x2="24" y2="6" />
              </g>
              <circle class="icon-node" cx="32" cy="17" r="2.5" fill="var(--color-accent)" stroke="none" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-3">IT Consulting</h3>
          <p class="text-text-muted text-sm leading-relaxed">Technology strategy, vendor evaluation, security audits, and operational optimization.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="relative py-32 px-6 overflow-hidden">
    <div class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] border border-accent/[0.06] rounded-full" data-parallax="0.1" aria-hidden="true"></div>
    <div class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[420px] h-[420px] border border-accent/[0.09] rounded-full" data-parallax="0.18" aria-hidden="true"></div>
    <div class="max-w-4xl mx-auto text-center relative">
      <p class="text-accent font-mono text-sm tracking-[0.3em] uppercase mb-2" data-animate="fade-up">About</p>
      <h2 class="text-4xl md:text-5xl font-bold mb-8 opacity-0" data-split>20 Years of Building</h2>
      <p class="text-text-muted text-lg leading-relaxed mb-8" data-animate="fade-up">
        From enterprise data centers to production SaaS platforms — two decades of engineering
        systems that work at scale. Not just architecture on a whiteboard, but the kind you
        deploy, monitor, and stand behind.
      </p>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="relative py-32 px-6 bg-surface overflow-hidden">
    <!-- Ambient: pulsing rings + floating geometry behind the CTA -->
    <div class="pointer-events-none absolute inset-0 flex items-center justify-center" aria-hidden="true">
      <div class="contact-ring w-72 h-72"></div>
      <div class="contact-ring w-72 h-72" style="animation-delay: 2s"></div>
      <div class="float-shape left-[18%] top-[25%] w-4 h-4 border border-accent/30 rotate-45"></div>
      <div class="float-shape right-[20%] top-[35%] w-3 h-3 bg-accent/20 rounded-full" style="animation-delay: 1.5s"></div>
      <div class="float-shape left-[28%] bottom-[20%] w-5 h-5 border border-accent-secondary/30" style="animation-delay: 3s"></div>
      <div class="float-shape right-[26%] bottom-[28%] w-4 h-4 border border-accent/25 rotate-12 rounded-sm" style="animation-delay: 4.5s"></div>
    </div>
    <div class="max-w-2xl mx-auto text-center relative">
      <p class="text-accent font-mono text-sm tracking-[0.3em] uppercase mb-2" data-animate="fade-up">Get in Touch</p>
      <h2 class="text-4xl md:text-5xl font-bold mb-8 opacity-0" data-split>Let's Build Something</h2>
      <a href="mailto:steven@thenobleengineer.com" class="cta-button inline-block px-8 py-4 bg-accent text-void font-semibold rounded-lg glow-border" data-animate="fade-up">
        Start a Conversation
      </a>
    </div>
  </section>
</Layout>

<script>
  import { initHero } from '../scripts/hero'
  import { initAnimations } from '../scripts/animations'
  import { initInteractions } from '../scripts/interactions'

  initHero()
  initAnimations()
  initInteractions()
</script>
