---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'The Noble Engineer',
  description = 'Technology consulting, engineering, and innovation'
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <noscript>
      <style>
        /* No JS: never leave content hidden behind animation initial states */
        .opacity-0 { opacity: 1 !important; }
      </style>
    </noscript>
  </head>
  <body class="bg-void text-text antialiased">
    <div id="cursor-glow" aria-hidden="true"></div>

    <nav class="fixed top-0 left-0 right-0 z-50 px-6 py-4 flex items-center justify-between backdrop-blur-md bg-void/60 border-b border-white/5 opacity-0">
      <a href={`${import.meta.env.BASE_URL}`} class="flex items-center">
        <img src="/logo-tne.png" alt="The Noble Engineer" class="h-8 w-auto brightness-0 invert" />
      </a>
      <div class="flex gap-4 sm:gap-8 text-sm text-text-muted">
        <a href="#work" data-nav-link class="nav-link">Services</a>
        <a href="#capabilities" data-nav-link class="nav-link hidden sm:inline">Capabilities</a>
        <a href="#about" data-nav-link class="nav-link">About</a>
        <a href="#contact" data-nav-link class="nav-link">Contact</a>
      </div>
      <div data-scroll-progress class="absolute bottom-0 left-0 right-0 h-px bg-accent origin-left scale-x-0 shadow-[0_0_8px_var(--color-accent)]"></div>
    </nav>

    <slot />

    <footer class="border-t border-white/5 px-6 py-12 text-center text-text-muted text-sm">
      <p>&copy; {new Date().getFullYear()} The Noble Engineer. All rights reserved.</p>
    </footer>
  </body>
</html>
