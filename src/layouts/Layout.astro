---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'The Noble Engineer',
  description = 'Technology consulting, engineering, and innovation'
} = Astro.props

const year = new Date().getFullYear()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@1,400;1,500;1,600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <noscript>
      <style>
        /* No JS: never leave content hidden behind animation initial states */
        .opacity-0 { opacity: 1 !important; }
      </style>
    </noscript>
  </head>
  <body class="bg-void text-text antialiased">
    <div id="cursor-glow" aria-hidden="true"></div>

    <nav class="fixed top-0 left-0 right-0 z-50 px-6 py-3 flex items-center justify-between backdrop-blur-md bg-void/60 border-b border-white/5 opacity-0">
      <a href={`${import.meta.env.BASE_URL}`} class="group flex items-baseline gap-3 py-2">
        <span class="font-mono text-sm tracking-[0.25em] text-accent">TNE</span>
        <span class="hidden md:inline font-mono text-[0.65rem] tracking-[0.3em] uppercase text-text-muted group-hover:text-text transition-colors duration-300">The Noble Engineer</span>
      </a>
      <div class="flex gap-4 sm:gap-8 text-sm text-text-muted">
        <a href="#services" data-nav-link class="nav-link">Services</a>
        <a href="#about" data-nav-link class="nav-link">About</a>
        <a href="#contact" data-nav-link class="nav-link">Contact</a>
      </div>
      <div data-scroll-progress class="absolute bottom-0 left-0 right-0 h-px bg-accent origin-left scale-x-0 shadow-[0_0_8px_var(--color-accent)]"></div>
    </nav>

    <slot />

    <footer class="relative border-t border-white/5 px-6 pt-16 pb-10 overflow-hidden">
      <div class="pointer-events-none absolute -bottom-32 left-1/2 -translate-x-1/2 w-[600px] h-[300px] rounded-full bg-accent/[0.03] blur-3xl" aria-hidden="true"></div>
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-start md:items-end justify-between gap-10">
        <div>
          <p class="font-mono text-sm tracking-[0.25em] text-accent mb-3">TNE</p>
          <p class="font-mono text-[0.65rem] tracking-[0.3em] uppercase text-text-muted">The Noble Engineer</p>
          <p class="mt-2 text-xs text-text-muted">El Paso, TX — serving clients nationwide</p>
        </div>
        <div class="flex gap-8 text-sm text-text-muted">
          <a href="#services" class="nav-link">Services</a>
          <a href="#about" class="nav-link">About</a>
          <a href="#contact" class="nav-link">Contact</a>
        </div>
        <div class="md:text-right text-sm text-text-muted">
          <a href="mailto:steven@thenobleengineer.com" class="hover:text-text transition-colors duration-300">steven@thenobleengineer.com</a>
          <p class="mt-2 text-xs">&copy; {year} The Noble Engineer. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
